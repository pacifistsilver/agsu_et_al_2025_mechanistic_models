# ---------------------------------------------------------------------------
# Project outputs and data
#
# Extension bans are scoped to directories rather than global. The previous
# global `*.png` / `*.csv` / `*.json` rules meant the paper's own figures could
# not be committed, and silently swallowed config files.
# ---------------------------------------------------------------------------

# Raw data is downloaded, never committed (see scripts/download_data.py)
/data/raw/
/data/*.csv

# Inference traces and simulation outputs are regenerated
/results/
*.nc

# Snakemake and scratch
/.snakemake/
/.archive/
/output/
*.log

# Editor-local Claude settings
/.claude/

# Orphaned diagnostic plot dumps with no generating script in the repo. Kept
# on disk but untracked; regenerate from notebooks/05_abc_diagnostics.ipynb or
# delete. See the PR discussion.
/bmb_chp02_plots/
/exploratory_plots/
/ppc_plots/

# figures/output/ IS tracked: it holds the publication figures.
